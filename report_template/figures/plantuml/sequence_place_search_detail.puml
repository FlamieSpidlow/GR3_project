@startuml
title Sequence diagram quy trình tìm kiếm và xem chi tiết địa điểm

skinparam defaultFontName Arial
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam wrapWidth 180

actor "Người dùng" as User
participant "Frontend" as FE
participant "Backend API" as BE
database "MongoDB" as DB
participant "Goong API" as Goong

User -> FE : Nhập từ khóa hoặc chọn bộ lọc
FE -> BE : Gửi yêu cầu tìm kiếm địa điểm
BE -> DB : Truy vấn Place, Category, Tag
DB --> BE : Danh sách địa điểm phù hợp

alt Cần dữ liệu vị trí/địa điểm ngoài hệ thống
  BE -> Goong : Gọi API tìm kiếm/vị trí
  Goong --> BE : Trả dữ liệu địa điểm/vị trí
end

BE --> FE : Trả danh sách kết quả
FE --> User : Hiển thị danh sách địa điểm

User -> FE : Chọn một địa điểm
FE -> BE : Gửi yêu cầu lấy chi tiết địa điểm
BE -> DB : Truy vấn Place, Review, TicketType nếu có
DB --> BE : Thông tin chi tiết
BE --> FE : Trả thông tin địa điểm
FE --> User : Hiển thị chi tiết địa điểm

@enduml
