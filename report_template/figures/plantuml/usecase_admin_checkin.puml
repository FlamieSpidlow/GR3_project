@startuml
skinparam defaultFontName Arial
left to right direction

actor "Quản trị viên" as Admin
actor "Nhân viên" as Staff

rectangle "Quản trị và check-in" {
  usecase "Quản lý người dùng" as ManageUser
  usecase "Quản lý địa điểm" as ManagePlace
  usecase "Quản lý vé/thanh toán" as ManageTicket
  usecase "Quét QR vé" as ScanQR
  usecase "Xác minh vé" as VerifyTicket
  usecase "Ghi nhận check-in" as Checkin
}

Admin --> ManageUser
Admin --> ManagePlace
Admin --> ManageTicket
Admin --> ScanQR
Admin --> VerifyTicket
Admin --> Checkin

Staff --> ScanQR
Staff --> VerifyTicket
Staff --> Checkin
@enduml
