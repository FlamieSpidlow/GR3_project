@startuml
skinparam defaultFontName Arial
left to right direction

actor "Khách" as Guest
actor "Người dùng" as User

rectangle "Địa điểm và gợi ý" {
  usecase "Tìm kiếm địa điểm" as Search
  usecase "Xem chi tiết địa điểm" as Detail
  usecase "Nhận gợi ý địa điểm" as Suggest
  usecase "Cập nhật vị trí" as Location
  usecase "Lưu/bỏ yêu thích" as Favorite
}

Guest --> Search
Guest --> Detail

User --> Search
User --> Detail
User --> Suggest
User --> Location
User --> Favorite
@enduml
