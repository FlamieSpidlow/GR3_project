@startuml
skinparam defaultFontName Arial
left to right direction

actor "Khách" as Guest
actor "Người dùng" as User
actor "Quản trị viên" as Admin
actor "Nhân viên" as Staff

rectangle "TheWeekend" {
  usecase "Quản lý tài khoản" as UCAccount
  usecase "Tra cứu địa điểm" as UCPlace
  usecase "Gợi ý và hỏi đáp" as UCRecommend
  usecase "Đánh giá địa điểm" as UCReview
  usecase "Đặt vé và thanh toán" as UCTicket
  usecase "Quản trị hệ thống" as UCAdmin
  usecase "Check-in vé QR" as UCCheckin
}

Guest --> UCAccount
Guest --> UCPlace

User --> UCAccount
User --> UCPlace
User --> UCRecommend
User --> UCReview
User --> UCTicket

Admin --> UCAdmin
Admin --> UCCheckin
Admin --> UCTicket

Staff --> UCCheckin
@enduml
