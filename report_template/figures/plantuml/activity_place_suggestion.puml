@startuml
title Activity diagram quy trình tìm kiếm và gợi ý địa điểm

skinparam defaultFontName Arial
skinparam shadowing false
skinparam wrapWidth 180

start
:Người dùng nhập từ khóa hoặc mở trang gợi ý;

if (Người dùng đã đăng nhập?) then (Có)
  :Lấy thông tin hồ sơ và vị trí nếu có;
else (Không)
  :Sử dụng dữ liệu tra cứu công khai;
endif

:Gửi yêu cầu tới backend;
:Truy vấn dữ liệu địa điểm trong MongoDB;
:Áp dụng tiêu chí từ khóa, danh mục, tag hoặc vị trí nếu có;

if (Có dữ liệu phù hợp?) then (Có)
  :Sắp xếp và tạo danh sách địa điểm;
  :Hiển thị danh sách kết quả/gợi ý;
  :Người dùng chọn một địa điểm;
  :Hiển thị thông tin chi tiết địa điểm;
else (Không)
  :Hiển thị thông báo không có dữ liệu phù hợp;
endif

stop
@enduml
