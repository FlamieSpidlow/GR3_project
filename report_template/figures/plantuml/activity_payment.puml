@startuml
skinparam defaultFontName Arial
start
:Người dùng chọn địa điểm;
:Chọn ngày đi và số lượng vé;
:Gửi yêu cầu đặt vé;

if (Dữ liệu hợp lệ?) then (Có)
  :Tạo đơn đặt vé;
  :Tạo yêu cầu thanh toán PayOS;
  :Trả thông tin thanh toán;
  :Người dùng thực hiện thanh toán;
  if (Thanh toán được xác nhận?) then (Có)
    :Cập nhật đơn đặt vé;
    :Sinh vé QR;
    :Thông báo kết quả thành công;
  else (Không)
    :Giữ trạng thái chờ hoặc cập nhật lỗi;
  endif
else (Không)
  :Trả thông báo lỗi;
endif

stop
@enduml
